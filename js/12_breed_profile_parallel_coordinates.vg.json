{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "width": 410,
  "height": 390,

  "background": null,

  "padding": {
    "left": 8,
    "right": 12,
    "top": 5,
    "bottom": 5
  },

  "title": {
    "text": "How Different Are Breed Profiles?",
    "subtitle": [
      "Each line follows one breed across body size, lifespan and general health",
      "Choose a breed or hover a line to isolate it"
    ],
    "anchor": "start",
    "font": "Inter",
    "fontSize": 18,
    "fontWeight": 700,
    "subtitleFont": "Inter",
    "subtitleFontSize": 10,
    "subtitleColor": "#6F675F",
    "subtitlePadding": 4,
    "color": "#24211E",
    "offset": 12
  },

  "data": {
    "url": "data/breed_profile_metrics.csv"
  },

  "transform": [
    {
      "calculate": "datum.Metric === 'Height (cm)' ? 1 : datum.Metric === 'Weight (kg)' ? 2 : datum.Metric === 'Lifespan (years)' ? 3 : 4",
      "as": "MetricOrder"
    }
  ],

  "params": [
    {
      "name": "breedPick",
      "value": "Labrador Retriever",

      "bind": {
        "input": "select",
        "name": "Highlight breed: ",

        "options": [
          "Australian Cattle Dog",
          "Australian Shepherd",
          "Beagle",
          "Bernese Mountain Dog",
          "Border Collie",
          "Cavalier King Charles Spaniel",
          "Chihuahua",
          "French Bulldog",
          "German Shepherd Dog",
          "Golden Retriever",
          "Great Dane",
          "Jack Russell Terrier",
          "Labrador Retriever",
          "Poodle",
          "Pug",
          "Rottweiler",
          "Shiba Inu",
          "Siberian Husky",
          "Staffordshire Bull Terrier",
          "Whippet"
        ]
      }
    },

    {
      "name": "breedHover",

      "select": {
        "type": "point",
        "fields": [
          "Breed"
        ],
        "on": "pointerover",
        "clear": "pointerout",
        "toggle": false
      }
    }
  ],

  "mark": {
    "type": "line",
    "strokeCap": "round",
    "strokeJoin": "round",

    "point": {
      "filled": true,
      "size": 48
    },

    "cursor": "pointer"
  },

  "encoding": {
    "x": {
      "field": "MetricOrder",
      "type": "quantitative",

      "scale": {
        "domain": [
          1,
          4
        ],
        "nice": false,
        "padding": 0.08
      },

      "axis": {
        "title": null,

        "values": [
          1,
          2,
          3,
          4
        ],

        "labelExpr": "datum.value === 1 ? 'Height' : datum.value === 2 ? 'Weight' : datum.value === 3 ? 'Lifespan' : 'Health'",

        "labelFont": "Inter",
        "labelFontSize": 10,
        "labelFontWeight": 700,
        "labelColor": "#24211E",
        "labelPadding": 10,
        "labelAngle": 0,

        "ticks": false,
        "domain": false,

        "grid": true,
        "gridColor": "#DCD4CA",
        "gridWidth": 1.2
      }
    },

    "y": {
      "field": "Normalized",
      "type": "quantitative",

      "scale": {
        "domain": [
          0,
          1
        ],
        "nice": false
      },

      "axis": {
        "title": "Relative position within each metric",

        "titleFont": "Inter",
        "titleFontSize": 10,
        "titleFontWeight": 600,
        "titleColor": "#6F675F",
        "titlePadding": 10,

        "values": [
          0,
          1
        ],

        "labelExpr": "datum.value === 1 ? 'HIGH' : 'LOW'",

        "labelFont": "Inter",
        "labelFontSize": 9,
        "labelFontWeight": 700,
        "labelColor": "#81776D",
        "labelPadding": 5,

        "ticks": false,
        "domain": false,
        "grid": false
      }
    },

    "order": {
      "field": "MetricOrder",
      "type": "quantitative"
    },

    "detail": {
      "field": "Breed"
    },

    "color": {
      "condition": [
        {
          "param": "breedHover",
          "empty": false,
          "value": "#3C7D7B"
        },

        {
          "test": "datum.Breed === breedPick",
          "value": "#C96A4A"
        }
      ],

      "value": "#CFC8BF"
    },

    "opacity": {
      "condition": [
        {
          "param": "breedHover",
          "empty": false,
          "value": 1
        },

        {
          "test": "datum.Breed === breedPick",
          "value": 1
        }
      ],

      "value": 0.22
    },

    "strokeWidth": {
      "condition": [
        {
          "param": "breedHover",
          "empty": false,
          "value": 3
        },

        {
          "test": "datum.Breed === breedPick",
          "value": 3.5
        }
      ],

      "value": 1.15
    },

    "tooltip": [
      {
        "field": "Breed",
        "type": "nominal",
        "title": "Breed"
      },

      {
        "field": "Group",
        "type": "nominal",
        "title": "Group"
      },

      {
        "field": "Metric",
        "type": "nominal",
        "title": "Metric"
      },

      {
        "field": "Value",
        "type": "quantitative",
        "title": "Actual value",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}