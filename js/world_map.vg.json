{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 850,
  "height": 480,

  "title": {
    "text": "Where Did the World's Dog Breeds Originate?",
    "subtitle": "Circle size represents the number of recognised breeds associated with each country",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "anchor": "start"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KushBerry06/FIT3179_DV2/refs/heads/main/data/world_countries.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },

      "projection": {
        "type": "equalEarth"
      },

      "mark": {
        "type": "geoshape",
        "fill": "#EEEAE3",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/KushBerry06/FIT3179_DV2/refs/heads/main/data/breed_origins_map.csv",
        "format": {
          "type": "csv"
        }
      },

      "projection": {
        "type": "equalEarth"
      },

      "mark": {
        "type": "circle",
        "color": "#C96A4A",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 0.8
      },

      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "Breed_Count",
          "type": "quantitative",
          "title": "Number of recognised breeds",
          "scale": {
            "domain": [1, 58],
            "range": [30, 1000]
          }
        },

        "tooltip": [
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Breed_Count",
            "type": "quantitative",
            "title": "Recognised breeds"
          },
          {
            "field": "Top_Breed_Group",
            "type": "nominal",
            "title": "Most common breed group"
          },
          {
            "field": "Example_Breeds",
            "type": "nominal",
            "title": "Example breeds"
          }
        ]
      }
    }
  ],

  "config": {
    "background": "#FAF8F4",
    "view": {
      "stroke": null
    }
  }
}
