{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 800,
  "height": 430,
  "padding": 5,
  "background": "#FCFAF6",
  "title": {
    "text": "Which Breed Groups Accounted for 2025 Registrations?",
    "subtitle": "Rectangle area represents Dogs Australia national registrations in 2025",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13
  },
  "data": [
    {
      "name": "tree",
      "values": [
        {
          "id": "All",
          "parent": null,
          "value": 0
        },
        {
          "id": "Toys",
          "parent": "All",
          "value": 6255,
          "share": 13.2
        },
        {
          "id": "Terriers",
          "parent": "All",
          "value": 7137,
          "share": 15.1
        },
        {
          "id": "Gundogs",
          "parent": "All",
          "value": 12283,
          "share": 26.0
        },
        {
          "id": "Hounds",
          "parent": "All",
          "value": 2993,
          "share": 6.3
        },
        {
          "id": "Working Dogs",
          "parent": "All",
          "value": 8656,
          "share": 18.3
        },
        {
          "id": "Utility",
          "parent": "All",
          "value": 5775,
          "share": 12.2
        },
        {
          "id": "Non-Sporting",
          "parent": "All",
          "value": 4189,
          "share": 8.9
        }
      ],
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "size": [
            800,
            430
          ],
          "padding": 2
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "c",
      "type": "ordinal",
      "domain": {
        "data": "leaves",
        "field": "id"
      },
      "range": {
        "scheme": "tableau10"
      }
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "c",
            "field": "id"
          },
          "stroke": {
            "value": "#FCFAF6"
          },
          "strokeWidth": {
            "value": 2
          },
          "tooltip": {
            "signal": "datum.id + ': ' + format(datum.value, ',') + ' registrations'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "(datum.x0 + datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1)/2 - 7"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "field": "id"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "white"
          },
          "limit": {
            "signal": "datum.x1-datum.x0-8"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "(datum.x0 + datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1)/2 + 11"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "format(datum.value, ',') + ' (' + format(datum.value/47288, '.0%') + ')'"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "white"
          }
        }
      }
    }
  ]
}